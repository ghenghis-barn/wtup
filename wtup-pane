#!/usr/bin/env bash
set -euo pipefail

role="${1:-}"
if [[ -z "$role" ]]; then
  echo "usage: wtup-pane <backend|frontend|storybook|app|ds-storybook|ds-components|consumer-app|consumer-backend>" >&2
  exit 2
fi

slugify() {
  local input="$1"
  printf '%s' "$input" |
    tr '[:upper:]' '[:lower:]' |
    sed -E 's/[^a-z0-9.]+/-/g; s/^-+//; s/-+$//; s/\.+/./g; s/^\.+//; s/\.+$//'
}

wt_name="${WORKTREE_NAME:-${ZELLIJ_SESSION_NAME:-worktree}}"
wt_host="${WORKTREE_HOST:-}"
if [[ -z "$wt_host" ]]; then
  wt_host="$(slugify "$wt_name")"
fi

if [[ -z "$wt_host" ]]; then
  echo "wtup-pane: could not derive WORKTREE_HOST" >&2
  exit 1
fi

# Resolve portless URL components for per-worktree origins
proxy_port="${PORTLESS_PORT:-}"
if [[ -z "$proxy_port" ]]; then
  if [[ -f "$HOME/.portless/proxy.port" ]]; then
    proxy_port="$(tr -d '\r\n' < "$HOME/.portless/proxy.port" || true)"
  elif [[ -f "/tmp/portless/proxy.port" ]]; then
    proxy_port="$(tr -d '\r\n' < "/tmp/portless/proxy.port" || true)"
  else
    proxy_port="1355"
  fi
fi
if ! [[ "$proxy_port" =~ ^[0-9]+$ ]]; then
  proxy_port="1355"
fi

tls=0
if [[ "${PORTLESS_HTTPS:-}" == "1" ]] || [[ "${PORTLESS_HTTPS:-}" == "true" ]]; then
  tls=1
fi
if [[ -f "$HOME/.portless/proxy.tls" ]] || [[ -f "/tmp/portless/proxy.tls" ]]; then
  tls=1
fi

proto="http"
default_port="80"
if [[ "$tls" == "1" ]]; then
  proto="https"
  default_port="443"
fi

fmt_origin() {
  local host="$1"
  if [[ "$proxy_port" == "$default_port" ]]; then
    printf '%s://%s' "$proto" "$host"
  else
    printf '%s://%s:%s' "$proto" "$host" "$proxy_port"
  fi
}

frontend_origin="$(fmt_origin "${wt_host}.localhost")"
backend_origin="$(fmt_origin "flexplorer-api.${wt_host}.localhost")"
storybook_origin="$(fmt_origin "storybook.${wt_host}.localhost")"

ds_host="${AURORA_DS_WORKTREE_HOST:-$wt_host}"
consumer_host="${AURORA_CONSUMER_WORKTREE_HOST:-$wt_host}"
ds_storybook_origin="$(fmt_origin "storybook.${ds_host}.localhost")"
consumer_frontend_origin="$(fmt_origin "${consumer_host}.localhost")"
consumer_backend_origin="$(fmt_origin "flexplorer-api.${consumer_host}.localhost")"

resolve_frontend_run_command() {
  if [[ -n "${WTUP_FRONTEND_RUN_COMMAND:-}" ]]; then
    printf '%s' "${WTUP_FRONTEND_RUN_COMMAND}"
    return
  fi

  if [[ -f pnpm-lock.yaml ]] && command -v pnpm >/dev/null 2>&1; then
    printf 'pnpm run dev'
    return
  fi

  if [[ -f yarn.lock ]] && command -v yarn >/dev/null 2>&1; then
    printf 'yarn dev'
    return
  fi

  if [[ -f bun.lockb || -f bun.lock ]] && command -v bun >/dev/null 2>&1; then
    printf 'bun run dev'
    return
  fi

  printf 'npm run dev'
}

escape_bash_double_quoted() {
  local value="$1"
  value="${value//\\/\\\\}"
  value="${value//\"/\\\"}"
  printf '%s' "$value"
}

case "$role" in
  backend|consumer-backend)
    backend_portless_host="flexplorer-api.${wt_host}"
    backend_allowed_frontend_origin="$frontend_origin"
    backend_allowed_storybook_origin="$storybook_origin"
    if [[ "$role" == "consumer-backend" ]]; then
      backend_portless_host="flexplorer-api.${consumer_host}"
      backend_allowed_frontend_origin="$consumer_frontend_origin"
      backend_allowed_storybook_origin="$ds_storybook_origin"
    fi

    # Backend bootstrap for clean worktrees:
    # - ensure venv
    # - install requirements
    if command -v git >/dev/null 2>&1; then
      repo_root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
      if [[ -n "$repo_root" ]] && [[ -d "$repo_root/services/flexplorer-api/backend" ]]; then
        cd "$repo_root/services/flexplorer-api/backend"
      fi
    fi

    if [[ -f requirements.txt ]]; then
      echo "[wtup] backend: ensuring venv (.venv)" >&2
      uv venv
      # shellcheck disable=SC1091
      source .venv/bin/activate

      req_hash=""
      if command -v sha256sum >/dev/null 2>&1; then
        req_hash="$(sha256sum requirements.txt | awk '{print $1}')"
      fi
      stamp_file=".venv/.wtup_requirements.sha256"
      installed_hash=""
      if [[ -n "$req_hash" ]] && [[ -f "$stamp_file" ]]; then
        installed_hash="$(tr -d '\r\n' < "$stamp_file" || true)"
      fi

      if [[ -n "$req_hash" ]] && [[ "$installed_hash" == "$req_hash" ]]; then
        :
      else
        echo "[wtup] backend: installing requirements.txt" >&2
        uv pip install -r requirements.txt
        if [[ -n "$req_hash" ]]; then
          printf '%s\n' "$req_hash" > "$stamp_file"
        fi
      fi
    else
      echo "[wtup] backend: warning: requirements.txt not found; skipping install" >&2
    fi

    FLEXPLORER_ALLOWED_ORIGINS="${backend_allowed_frontend_origin},${backend_allowed_storybook_origin}" \
      FLEXPLORER_API_BASE_PATH= API_BASE_PATH= FLEXPLORER_BASE_PATH= \
      exec portless "$backend_portless_host" bash -lc 'exec .venv/bin/python -m uvicorn main:app --reload --host "$HOST" --port "$PORT"'
    ;;
  frontend)
    if [[ -x ./node_modules/.bin/vite ]]; then
      VITE_FLEXPLORER_API_ORIGIN="$backend_origin" VITE_EXPLORER_API_ORIGIN="$backend_origin" \
        exec portless "${wt_host}" ./node_modules/.bin/vite dev
    else
      VITE_FLEXPLORER_API_ORIGIN="$backend_origin" VITE_EXPLORER_API_ORIGIN="$backend_origin" \
        exec portless "${wt_host}" vite dev
    fi
    ;;
  storybook)
    if [[ -x ./node_modules/.bin/storybook ]]; then
      VITE_FLEXPLORER_API_ORIGIN="$backend_origin" VITE_EXPLORER_API_ORIGIN="$backend_origin" \
        exec portless "storybook.${wt_host}" bash -ic 'exec ./node_modules/.bin/storybook dev -p "$PORT" --host "$HOST"'
    else
      VITE_FLEXPLORER_API_ORIGIN="$backend_origin" VITE_EXPLORER_API_ORIGIN="$backend_origin" \
        exec portless "storybook.${wt_host}" bash -ic 'exec storybook dev -p "$PORT" --host "$HOST"'
    fi
    ;;
  app|consumer-app)
    app_portless_host="$wt_host"
    app_backend_origin="$backend_origin"
    if [[ "$role" == "consumer-app" ]]; then
      app_portless_host="$consumer_host"
      app_backend_origin="$consumer_backend_origin"
    fi
    frontend_run_command="$(resolve_frontend_run_command)"
    frontend_run_command="$(escape_bash_double_quoted "$frontend_run_command")"
    VITE_FLEXPLORER_API_ORIGIN="$app_backend_origin" VITE_EXPLORER_API_ORIGIN="$app_backend_origin" \
      exec portless "$app_portless_host" bash -lc "exec ${frontend_run_command}"
    ;;
  ds-storybook)
    if [[ -n "${AURORA_UI_WORKTREE:-}" && -d "${AURORA_UI_WORKTREE:-}" ]]; then
      cd "$AURORA_UI_WORKTREE"
    elif command -v git >/dev/null 2>&1; then
      repo_root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
      if [[ -n "$repo_root" ]]; then
        cd "$repo_root"
      fi
    fi

    if [[ ! -d storybook-v2 ]]; then
      echo "[wtup] ds-storybook: storybook-v2 not found in $(pwd)" >&2
      exit 1
    fi

    exec portless "storybook.${ds_host}" bash -lc 'exec yarn workspace @aurora-ui/storybook-v2 run storybook -- -p "$PORT" --host "$HOST"'
    ;;
  ds-components)
    if [[ -n "${AURORA_UI_WORKTREE:-}" && -d "${AURORA_UI_WORKTREE:-}" ]]; then
      cd "$AURORA_UI_WORKTREE"
    elif command -v git >/dev/null 2>&1; then
      repo_root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
      if [[ -n "$repo_root" ]]; then
        cd "$repo_root"
      fi
    fi

    if [[ ! -d packages/components-v2 ]]; then
      echo "[wtup] ds-components: packages/components-v2 not found in $(pwd)" >&2
      exit 1
    fi

    cd packages/components-v2
    if [[ -n "${WTUP_DS_COMPONENTS_COMMAND:-}" ]]; then
      ds_components_command="$(escape_bash_double_quoted "$WTUP_DS_COMPONENTS_COMMAND")"
      exec bash -lc "exec ${ds_components_command}"
    fi

    printf '[wtup] components-v2 package shell\n'
    printf 'source:   %s\n' "${AURORA_DS_COMPONENTS_SOURCE:-$(pwd)/src}"
    printf 'package:  %s\n' "${AURORA_DS_COMPONENTS_PACKAGE:-$(pwd)/dist/alpha-package}"
    printf 'storybook %s\n' "$ds_storybook_origin"
    exec bash -i
    ;;
  *)
    echo "unknown role: $role" >&2
    exit 2
    ;;
esac
