#!/usr/bin/env bash
set -euo pipefail

workspace_id="${WTUP_HERDR_WORKSPACE_ID:?WTUP_HERDR_WORKSPACE_ID is required}"
main_tab_id="${WTUP_HERDR_TAB_ID:?WTUP_HERDR_TAB_ID is required}"
root_pane_id="${WTUP_HERDR_ROOT_PANE_ID:?WTUP_HERDR_ROOT_PANE_ID is required}"
append_layout="${WTUP_HERDR_APPEND_LAYOUT:-0}"
workflow="${WTUP_WORKFLOW:-auto}"
project_config="${WTUP_PROJECT_CONFIG:-fullstack}"
wt_root="${WTUP_ROOT:?WTUP_ROOT is required}"
consumer_root="${AURORA_CONSUMER_WORKTREE:-$wt_root}"

trap 'echo "wtup-herdr: layout creation failed; the Herdr workspace and worktree were retained" >&2' ERR

script_dir="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd -P)"
layout_bin="$script_dir/wtup-layout"
if [[ ! -x "$layout_bin" ]]; then
  echo "wtup-herdr: canonical layout renderer is not installed: $layout_bin" >&2
  exit 1
fi

json_value() {
  local json="$1"
  local path="$2"

  python3 - "$json" "$path" <<'PY'
import json
import sys

value = json.loads(sys.argv[1])
for part in sys.argv[2].split("."):
    value = value[part]
print(value)
PY
}

decode() {
  printf '%s' "$1" | base64 --decode
}

decode_command() {
  local value="$1"
  python3 - "$value" <<'PY'
import base64
import json
import sys

for arg in json.loads(base64.b64decode(sys.argv[1]).decode()):
    print(arg)
PY
}

env_args=()
run_env=()
for name in \
  WORKTREE_NAME WORKTREE_HOST WTUP_PROJECT_CONFIG WTUP_WORKFLOW WTUP_MANAGED_ENV \
  WTUP_FRONTEND_RUN_COMMAND WTUP_DS_COMPONENTS_COMMAND \
  PORTLESS_PORT PORTLESS_HTTPS \
  AURORA_UI_WORKTREE AURORA_DS_WORKTREE AURORA_DS_WORKTREE_HOST \
  AURORA_DS_CHANNEL AURORA_DS_LINK_MODE AURORA_DS_COMPONENTS_SOURCE \
  AURORA_DS_COMPONENTS_PACKAGE AURORA_DS_STORYBOOK_STATIC AURORA_DS_SNAPSHOT \
  AURORA_CONSUMER_WORKTREE AURORA_CONSUMER_WORKTREE_HOST AURORA_CONSUMER_KIND; do
  if [[ -v "$name" ]]; then
    env_args+=(--env "${name}=${!name}")
    run_env+=("${name}=${!name}")
  fi
done

rename_tab() {
  herdr tab rename "$1" "$2" >/dev/null
}

rename_pane() {
  herdr pane rename "$1" "$2" >/dev/null
}

run_pane() {
  local pane_id="$1"
  local label="$2"
  shift 2

  rename_pane "$pane_id" "$label"
  herdr pane run "$pane_id" env "${run_env[@]}" "$@" >/dev/null
}

create_tab() {
  local label="$1"
  local cwd="$2"
  local response=""

  response="$(herdr tab create \
    --workspace "$workspace_id" \
    --cwd "$cwd" \
    --label "$label" \
    "${env_args[@]}" \
    --no-focus)"
  printf '%s\t%s\n' \
    "$(json_value "$response" "result.tab.tab_id")" \
    "$(json_value "$response" "result.root_pane.pane_id")"
}

split_pane() {
  local source_pane="$1"
  local direction="$2"
  local ratio="$3"
  local cwd="$4"
  local response=""

  response="$(herdr pane split "$source_pane" \
    --direction "$direction" \
    --ratio "$ratio" \
    --cwd "$cwd" \
    "${env_args[@]}" \
    --no-focus)"
  json_value "$response" "result.pane.pane_id"
}

start_tool() {
  local pane_id="$1"
  local command="$2"
  local kind="${command%% *}"
  local label="$kind"
  local output=""
  local attempt=0

  [[ -n "$label" ]] || label="tool"
  rename_pane "$pane_id" "$label"

  case "$command" in
    pi|claude|codex|gemini|cursor|devin|agy|cline|omp|mastracode|opencode|copilot|kimi|kiro|droid|amp|grok|hermes|kilo|qodercli|maki)
      for (( attempt=1; attempt<=50; attempt++ )); do
        if output="$(herdr agent start "$label" --kind "$kind" --pane "$pane_id" 2>&1)"; then
          return
        fi
        if [[ "$output" != *'"code":"agent_pane_busy"'* ]]; then
          printf '%s\n' "$output" >&2
          return 1
        fi
        sleep 0.1
      done
      printf '%s\n' "$output" >&2
      return 1
      ;;
    *)
      herdr pane run "$pane_id" bash -ic "exec ${command}" >/dev/null
      ;;
  esac
}

create_agents_tab() {
  local configured="${WTUP_TOOL_COMMANDS:-${WTUP_WT_COMMANDS:-omp,codex}}"
  local tokens=()
  local commands=()
  local token=""
  local fields=""
  local tab_id=""
  local pane_id=""
  local next_pane=""
  local i=0

  case "${WTUP_TERMINAL_BACKEND:-auto}" in
    none|off|0|false)
      return
      ;;
  esac

  IFS=',' read -r -a tokens <<<"$configured"
  for token in "${tokens[@]}"; do
    token="${token#"${token%%[![:space:]]*}"}"
    token="${token%"${token##*[![:space:]]}"}"
    [[ -n "$token" ]] && commands+=("$token")
  done
  (( ${#commands[@]} > 0 )) || return

  fields="$(create_tab "Agents" "$wt_root")"
  IFS=$'\t' read -r tab_id pane_id <<<"$fields"
  start_tool "$pane_id" "${commands[0]}"

  for (( i=1; i<${#commands[@]}; i++ )); do
    next_pane="$(split_pane "$pane_id" "right" "0.5" "$wt_root")"
    start_tool "$next_pane" "${commands[i]}"
  done
}

layout_args=(
  herdr
  --workflow "$workflow"
  --project-config "$project_config"
  --root "$wt_root"
  --consumer-root "$consumer_root"
)
if [[ "${WTUP_CONSUMER_HAS_BACKEND:-0}" == "1" ]]; then
  layout_args+=(--consumer-backend)
fi

declare -A pane_ids=()
tab_count=0
layout_records="$("$layout_bin" "${layout_args[@]}")"
herdr workspace report-metadata "$workspace_id" \
  --source wtup \
  --token "wtup_layout=${workflow}:${project_config}:2:building" >/dev/null
while IFS=$'\t' read -r record first second third fourth fifth; do
  case "$record" in
    TAB)
      tab_key="$first"
      tab_label="$(decode "$second")"
      tab_cwd="$(decode "$third")"
      root_key="$fourth"
      if (( tab_count == 0 )) && [[ "$append_layout" != "1" ]]; then
        rename_tab "$main_tab_id" "$tab_label"
        pane_ids["$root_key"]="$root_pane_id"
      else
        fields="$(create_tab "$tab_label" "$tab_cwd")"
        IFS=$'\t' read -r created_tab created_pane <<<"$fields"
        pane_ids["$root_key"]="$created_pane"
        if (( tab_count == 0 )); then
          main_tab_id="$created_tab"
        fi
      fi
      tab_count=$((tab_count + 1))
      ;;
    SPLIT)
      source_key="$first"
      created_key="$second"
      direction="$third"
      ratio="$fourth"
      split_cwd="$(decode "$fifth")"
      pane_ids["$created_key"]="$(split_pane "${pane_ids[$source_key]}" "$direction" "$ratio" "$split_cwd")"
      ;;
    PANE)
      pane_key="$first"
      pane_label="$(decode "$second")"
      command_encoded="$fourth"
      command=()
      mapfile -t command < <(decode_command "$command_encoded")
      if (( ${#command[@]} > 0 )); then
        run_pane "${pane_ids[$pane_key]}" "$pane_label" "${command[@]}"
      else
        rename_pane "${pane_ids[$pane_key]}" "$pane_label"
      fi
      ;;
    "")
      ;;
    *)
      echo "wtup-herdr: unknown canonical layout record: $record" >&2
      exit 2
      ;;
  esac
done <<<"$layout_records"

create_agents_tab
herdr workspace report-metadata "$workspace_id" \
  --source wtup \
  --token "wtup_layout=${workflow}:${project_config}:2" >/dev/null
herdr tab focus "$main_tab_id" >/dev/null
herdr workspace focus "$workspace_id" >/dev/null
