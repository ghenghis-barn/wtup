#!/usr/bin/env bash
set -euo pipefail

slugify() {
  local input="$1"
  printf '%s' "$input" |
    tr '[:upper:]' '[:lower:]' |
    sed -E 's/[^a-z0-9.]+/-/g; s/^-+//; s/-+$//; s/\.+/./g; s/^\.+//; s/\.+$//'
}

abs_path() {
  local base="$1"
  local p="$2"
  if [[ "$p" == /* ]]; then
    realpath -m "$p"
  else
    realpath -m "$base/$p"
  fi
}

trim_whitespace() {
  local value="$1"
  value="${value#"${value%%[![:space:]]*}"}"
  value="${value%"${value##*[![:space:]]}"}"
  printf '%s' "$value"
}

pattern_list_matches() {
  local value="$1"
  local patterns_csv="$2"
  local pattern=""
  local patterns=()

  if [[ -z "$patterns_csv" ]]; then
    return 1
  fi

  IFS=',' read -r -a patterns <<< "$patterns_csv"
  for pattern in "${patterns[@]}"; do
    pattern="$(trim_whitespace "$pattern")"
    if [[ -n "$pattern" ]] && [[ "$value" == $pattern ]]; then
      return 0
    fi
  done

  return 1
}

resolve_common_repo_root() {
  local worktree_root="$1"
  local common_dir=""
  local common_abs=""

  common_dir="$(git -C "$worktree_root" rev-parse --git-common-dir 2>/dev/null || true)"
  if [[ -z "$common_dir" ]]; then
    return
  fi

  common_abs="$(abs_path "$worktree_root" "$common_dir")"
  if [[ "$common_abs" == */.git ]]; then
    printf '%s' "${common_abs%/.git}"
  fi
}

detect_project_config() {
  local worktree_root="$1"
  local worktree_name="$2"
  local explicit_config="${WTUP_PROJECT_CONFIG:-}"
  local frontend_patterns="${WTUP_FRONTEND_PROJECT_PATTERNS:-*forged-realms*}"
  local fullstack_patterns="${WTUP_FULLSTACK_PROJECT_PATTERNS:-}"
  local common_repo_root=""
  local candidate=""
  local candidates=()

  if [[ -n "$explicit_config" ]]; then
    printf '%s' "$explicit_config"
    return
  fi

  common_repo_root="$(resolve_common_repo_root "$worktree_root")"

  candidates+=("$worktree_root")
  candidates+=("$worktree_name")
  if [[ -n "$common_repo_root" ]]; then
    candidates+=("$common_repo_root")
    candidates+=("$(basename "$common_repo_root")")
  fi

  for candidate in "${candidates[@]}"; do
    if pattern_list_matches "$candidate" "$fullstack_patterns"; then
      printf 'fullstack'
      return
    fi
  done

  for candidate in "${candidates[@]}"; do
    if pattern_list_matches "$candidate" "$frontend_patterns"; then
      printf 'frontend'
      return
    fi
  done

  printf 'fullstack'
}

wt_root="$(git rev-parse --show-toplevel 2>/dev/null || pwd -P)"
wt_branch="$(git -C "$wt_root" rev-parse --abbrev-ref HEAD 2>/dev/null || true)"

wt_name="${WORKTREE_NAME:-}"
if [[ -z "$wt_name" ]]; then
  if [[ -n "$wt_branch" ]] && [[ "$wt_branch" != "HEAD" ]]; then
    wt_name="$wt_branch"
  else
    wt_name="$(basename "$wt_root")"
  fi
fi

wt_host="${WORKTREE_HOST:-}"
if [[ -z "$wt_host" ]]; then
  wt_host="$(slugify "$wt_name")"
fi

wt_project_config="$(detect_project_config "$wt_root" "$wt_name")"

proxy_port="${PORTLESS_PORT:-}"
if [[ -z "$proxy_port" ]]; then
  if [[ -f "$HOME/.portless/proxy.port" ]]; then
    proxy_port="$(tr -d '\r\n' < "$HOME/.portless/proxy.port" || true)"
  elif [[ -f "/tmp/portless/proxy.port" ]]; then
    proxy_port="$(tr -d '\r\n' < "/tmp/portless/proxy.port" || true)"
  else
    proxy_port="1355"
  fi
fi
if ! [[ "$proxy_port" =~ ^[0-9]+$ ]]; then
  proxy_port="1355"
fi

tls=0
if [[ -n "${PORTLESS_HTTPS+x}" ]]; then
  if [[ "${PORTLESS_HTTPS}" == "1" ]] || [[ "${PORTLESS_HTTPS}" == "true" ]]; then
    tls=1
  fi
elif [[ -f "$HOME/.portless/proxy.tls" ]] || [[ -f "/tmp/portless/proxy.tls" ]]; then
  tls=1
fi

proto="http"
default_port="80"
if [[ "$tls" == "1" ]]; then
  proto="https"
  default_port="443"
fi

fmt_url() {
  local host="$1"
  if [[ "$proxy_port" == "$default_port" ]]; then
    printf '%s://%s' "$proto" "$host"
  else
    printf '%s://%s:%s' "$proto" "$host" "$proxy_port"
  fi
}

frontend_host="${wt_host}.localhost"
backend_host="flexplorer-api.${wt_host}.localhost"
storybook_host="storybook.${wt_host}.localhost"
ds_host="${AURORA_DS_WORKTREE_HOST:-$wt_host}"
consumer_host="${AURORA_CONSUMER_WORKTREE_HOST:-$wt_host}"
ds_storybook_host="storybook.${ds_host}.localhost"
consumer_frontend_host="${consumer_host}.localhost"
consumer_backend_host="flexplorer-api.${consumer_host}.localhost"

frontend_url="$(fmt_url "$frontend_host")"
backend_url="$(fmt_url "$backend_host")"
storybook_url="$(fmt_url "$storybook_host")"
ds_storybook_url="$(fmt_url "$ds_storybook_host")"
consumer_frontend_url="$(fmt_url "$consumer_frontend_host")"
consumer_backend_url="$(fmt_url "$consumer_backend_host")"

printf 'Worktree: %s\n' "$wt_name"
printf 'Root:     %s\n' "$wt_root"
if [[ -n "$wt_branch" ]]; then
  printf 'Branch:   %s\n' "$wt_branch"
fi
printf 'Preset:   %s\n' "$wt_project_config"
printf 'Routes:\n'
if [[ "${WTUP_WORKFLOW:-auto}" == "component-only" ]]; then
  printf '  ds-storybook %s\n' "$ds_storybook_url"
elif [[ "${WTUP_WORKFLOW:-auto}" == "consumer-context" ]]; then
  printf '  ds-storybook %s\n' "$ds_storybook_url"
  printf '  consumer-app %s\n' "$consumer_frontend_url"
  if [[ "${AURORA_CONSUMER_KIND:-}" == "dse" || "${AURORA_CONSUMER_KIND:-}" == "fullstack" ]]; then
    printf '  consumer-api %s\n' "$consumer_backend_url"
  fi
else
  printf '  frontend  %s\n' "$frontend_url"
  if [[ "$wt_project_config" == "fullstack" ]]; then
    printf '  backend   %s\n' "$backend_url"
    printf '  storybook %s\n' "$storybook_url"
  fi
fi

if [[ "${WTUP_WORKFLOW:-auto}" == "component-only" || "${WTUP_WORKFLOW:-auto}" == "consumer-context" ]]; then
  printf '\nDesign system:\n'
  printf '  root      %s\n' "${AURORA_UI_WORKTREE:-${AURORA_DS_WORKTREE:-}}"
  printf '  channel   %s\n' "${AURORA_DS_CHANNEL:-alpha}"
  printf '  link mode %s\n' "${AURORA_DS_LINK_MODE:-source}"
  printf '  source    %s\n' "${AURORA_DS_COMPONENTS_SOURCE:-}"
  printf '  package   %s\n' "${AURORA_DS_COMPONENTS_PACKAGE:-}"
  printf '  storybook %s\n' "${AURORA_DS_STORYBOOK_STATIC:-}"
  printf '  snapshot  %s\n' "${AURORA_DS_SNAPSHOT:-}"

  if [[ -f "${AURORA_DS_SNAPSHOT:-}" ]] && command -v python3 >/dev/null 2>&1; then
    snapshot_id="$(python3 - "${AURORA_DS_SNAPSHOT:-}" <<'PY' 2>/dev/null || true
import json
import sys

try:
    with open(sys.argv[1], encoding="utf-8") as f:
        data = json.load(f)
except Exception:
    sys.exit(0)

for key in ("designSystemSnapshotId", "snapshotId", "id"):
    value = data.get(key)
    if value:
        print(value)
        break
PY
)"
    if [[ -n "${snapshot_id:-}" ]]; then
      printf '  snapshot id %s\n' "$snapshot_id"
    fi

    package_snapshot_metadata="${AURORA_DS_COMPONENTS_PACKAGE:-}/design-system-snapshot.json"
    if [[ -f "$package_snapshot_metadata" ]]; then
      package_snapshot_info="$(python3 - "$package_snapshot_metadata" <<'PY' 2>/dev/null || true
import json
import sys

try:
    with open(sys.argv[1], encoding="utf-8") as f:
        data = json.load(f)
except Exception:
    sys.exit(0)

snapshot_id = data.get("designSystemSnapshotId") or data.get("snapshotId") or data.get("id")
channel = data.get("designSystemChannel")

if snapshot_id:
    print(f"{snapshot_id}\t{channel or ''}")
PY
)"
      package_snapshot_id="${package_snapshot_info%%$'\t'*}"
      package_snapshot_channel="${package_snapshot_info#*$'\t'}"
      if [[ -n "${package_snapshot_id:-}" ]] && [[ "$package_snapshot_id" != "$package_snapshot_info" ]]; then
        if [[ "${package_snapshot_id:-}" != "${snapshot_id:-}" ]]; then
          printf '  package snapshot id %s\n' "$package_snapshot_id"
          printf '  snapshot warning package/static metadata differ\n'
        fi
        if [[ -n "${AURORA_DS_CHANNEL:-}" && -n "${package_snapshot_channel:-}" && "$package_snapshot_channel" != "${AURORA_DS_CHANNEL:-}" ]]; then
          printf '  snapshot warning package channel is %s\n' "$package_snapshot_channel"
        fi
      fi
    fi
  fi
fi

if [[ "${WTUP_WORKFLOW:-auto}" == "consumer-context" ]]; then
  printf '\nConsumer:\n'
  printf '  root      %s\n' "${AURORA_CONSUMER_WORKTREE:-}"
  printf '  kind      %s\n' "${AURORA_CONSUMER_KIND:-unknown}"
fi

if command -v portless >/dev/null 2>&1; then
  routes="$(NO_COLOR=1 portless list 2>/dev/null || true)"
  if [[ "${WTUP_WORKFLOW:-auto}" == "component-only" ]]; then
    active_lines="$(printf '%s\n' "$routes" | awk -v u1="$ds_storybook_url" 'index($0,u1) {print}')"
  elif [[ "${WTUP_WORKFLOW:-auto}" == "consumer-context" ]]; then
    active_lines="$(printf '%s\n' "$routes" | awk -v u1="$ds_storybook_url" -v u2="$consumer_frontend_url" -v u3="$consumer_backend_url" 'index($0,u1) || index($0,u2) || index($0,u3) {print}')"
  elif [[ "$wt_project_config" == "fullstack" ]]; then
    active_lines="$(printf '%s\n' "$routes" | awk -v u1="$frontend_url" -v u2="$backend_url" -v u3="$storybook_url" 'index($0,u1) || index($0,u2) || index($0,u3) {print}')"
  else
    active_lines="$(printf '%s\n' "$routes" | awk -v u1="$frontend_url" 'index($0,u1) {print}')"
  fi
  if [[ -n "$active_lines" ]]; then
    printf '\nActive routes (portless):\n'
    printf '%s\n' "$active_lines"
  fi
fi

if git -C "$wt_root" rev-parse --git-dir >/dev/null 2>&1; then
  printf '\nRecent commits:\n'
  git -C "$wt_root" --no-pager log -5 --oneline --decorate --no-color 2>/dev/null || true
fi
