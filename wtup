#!/usr/bin/env bash
set -euo pipefail

reset_session=0
from_latest_main=0
carry_changes=0
workflow="auto"
ds_target=""
consumer_target=""
ds_channel=""
ds_link="source"
consumer_kind="auto"
no_prompt=0
strict_workflow=0
workspace_backend_request="${WTUP_WORKSPACE_BACKEND:-auto}"
workspace_backend=""
herdr_workspace_id=""
herdr_tab_id=""
herdr_root_pane_id=""
herdr_already_open=0
herdr_append_layout=0

print_help() {
  cat <<'EOF' >&2
wtup - Launch a worktree dev workspace (zellij + portless + tools)

USAGE
  wtup [options] <worktree-branch-name|path-to-worktree>

ARGUMENTS
  <worktree-branch-name>
    If this is not an existing directory, wtup treats it as a local branch name.
    - If a worktree already exists for that branch, wtup reuses it.
    - Otherwise, wtup creates a new git worktree and checks out that branch.
    - Branch names with slashes are supported, for example feat/my-feature.
    - New worktree directories are flattened to a single path segment, for
      example worktrees/feat-my-feature.

  <path-to-worktree>
    If this is an existing directory, wtup treats it as an existing worktree and
    will not create a new one.

OPTIONS
  --latest-main, -m
    When creating a NEW worktree, base the branch on the latest remote main.
    By default, new branches are based on WTUP_BASE_REF (default: HEAD),
    which means the current checkout/worktree HEAD.
    wtup will best-effort:
      - detect origin/HEAD (preferred) or fall back to origin/main, origin/master
      - git fetch the remote main branch
      - create the branch from that remote-tracking ref

  --reset, -r
    Force a clean zellij session for this worktree (deletes the session first).
    Useful when you change the layout/scripts and don't want resurrection.

  --carry, -c
    Copy the *current* worktree's uncommitted changes (tracked + untracked) into
    the target worktree.
    - Source worktree stays unchanged (copy, not move).
    - Target worktree must be clean.
    - Only supported between worktrees of the same repo.
    - Uses git stash internally; if apply conflicts, the stash is kept.

  --workflow <auto|component-only|consumer-context>
    Select an explicit workspace workflow.
    - auto: current default behavior; one target worktree and existing
      frontend/fullstack detection.
    - component-only: aurora-ui DS work with Storybook v2 plus a components-v2
      package shell.
    - consumer-context: aurora-ui DS worktree plus one consumer app worktree.

  --component-only
    Alias for --workflow component-only.

  --product-context
    Alias for --workflow consumer-context.

  --ds <aurora-target>
    aurora-ui branch/path for component-only or consumer-context workflows.

  --consumer <repo-target>
    Consumer repo branch/path for consumer-context.

  --dse <repo-target>
    DSE-friendly alias for --consumer <repo-target> --consumer-kind dse.

  --ds-channel <stable|alpha>
    DS channel passed to consumer panes. Default for consumer-context: alpha.

  --ds-link <source|snapshot>
    DS link mode passed to consumer panes. Default: source.

  --consumer-kind <auto|dse|frontend|fullstack>
    Consumer preset hint. auto preserves existing frontend/fullstack detection.

  --no-prompt
    Do not prompt for missing workflow inputs; fail instead.

  --strict-workflow
    Fail instead of warning/falling back when requested workflow support is
    missing.

  --workspace-backend <auto|herdr|zellij>
    Select the workspace multiplexer. auto uses Herdr when invoked from a
    Herdr-managed pane and otherwise preserves the Zellij behavior.

  --help, -h, -help
    Show this help.

  --
    Stop processing options (treat the next token as the argument).

BEHAVIOR
  - Worktree creation
    - Must be run from inside an existing checkout of the target git repo
      (unless you pass an explicit worktree path).
    - If the branch exists locally:   git worktree add <dir> <branch>
    - If the branch does not exist:   git worktree add -b <branch> <dir> <base>
      where <base> is WTUP_BASE_REF (default: HEAD of the current
      checkout/worktree) or latest main with -m.
    - This means `wtup new-branch` from inside an existing feature worktree
      creates `new-branch` from that worktree's current commit by default.

  - Stale base warning (new worktrees only)
    If you create from WTUP_BASE_REF/HEAD and origin/main (or origin/master) is
    ahead, wtup prints a warning and suggests using -m.

  - Zellij
    - Session name: WORKTREE_HOST (a portless-safe slug of the worktree name)
    - Layout preset: auto-detected unless WTUP_PROJECT_CONFIG is set
    - Supported presets are rendered from the same canonical workspace model
      used by Herdr.
    - WTUP_ZELLIJ_LAYOUT opts into an external Zellij-only layout.
    - Default auto-detection matches forged-realms worktrees to frontend.
      Everything else falls back to fullstack.
    - Per-worktree layout is generated at: ~/.cache/wtup/layouts/<host>.kdl.
    - EXITED sessions are deleted automatically (to avoid resurrecting stale
      layouts/commands).

  - Tools terminal
    With the Herdr workspace backend, configured tools open in an Agents tab
    inside the target workspace. No outer terminal window is created.
    If wtup is run inside WezTerm (WEZTERM_PANE is set), the current tab becomes
    the Zellij workspace and wtup opens the configured tools in a sibling
    WezTerm tab rooted at the same worktree. Multiple tools are split inside
    that tab.
    Otherwise, if wt.exe/cmd.exe/wsl.exe are available, wtup opens a new Windows
    Terminal window using profile WTUP_WT_PROFILE (default: aurora_wsl).
    The tools are read from WTUP_TOOL_COMMANDS, falling back to WTUP_WT_COMMANDS,
    then omp,codex.
    Examples:
      - claude,codex
      - omp,claude,codex

ENVIRONMENT VARIABLES
  Worktree creation
    WTUP_WORKTREES_DIR   Where new worktrees are created.
                         Default: <parent-of-repo-toplevel>/worktrees
    WTUP_BASE_REF        Base ref for new branches when not using -m.
                         Default: HEAD
    WTUP_MAIN_REMOTE     Remote to treat as "main" remote (for -m / warnings).
                         Default: origin
    WTUP_MAIN_BRANCH     Branch name to treat as "main" (fallback if no remote HEAD).
                         Default: main

  Workspace preset
    WTUP_WORKTREE_HOST   Explicit Portless/session host override. Unlike the
                         pane-level WORKTREE_HOST, this applies when launching
                         another worktree from a wtup-managed workspace.
    WTUP_PROJECT_CONFIG  Explicit workspace preset override. Values: fullstack, frontend
                         - fullstack: frontend + backend + storybook panes
                         - frontend: single app pane + utility bash panes
                         If unset, wtup auto-detects based on the resolved
                         worktree and common repo path.
    AGENT_BROWSER_SESSION
                         Exported as wtup-<WORKTREE_HOST>. agent-browser uses
                         this stable isolated session automatically.
    AGENT_BROWSER_AUTO_CONNECT
                         Cleared before workspace composition so agent-browser
                         cannot attach to an already-running user Chrome session.
    WTUP_FRONTEND_PROJECT_PATTERNS
                         Comma-separated shell globs used for frontend auto-detection.
                         Matched against the worktree path, common repo path,
                         common repo basename, and worktree name.
                         Default: *forged-realms*
    WTUP_FULLSTACK_PROJECT_PATTERNS
                         Optional comma-separated shell globs that force the
                         fullstack preset before frontend matching.
    WTUP_FRONTEND_RUN_COMMAND
                         Command used by the frontend preset app pane.
                         Default: auto-detect package manager, then run the dev
                         script (pnpm/yarn/bun/npm)

  Zellij / layout
    WTUP_ZELLIJ_LAYOUT   Zellij layout name (file in ~/.config/zellij/layouts/).
                         If unset, wtup renders the selected preset from its
                         canonical backend-neutral workspace model.

  Workspace backend
    WTUP_WORKSPACE_BACKEND
                         Values: auto, herdr, zellij. In Herdr mode, wtup
                         creates native workspaces, tabs, and panes instead of
                         nesting Zellij or spawning outer terminal windows.

  Tools terminal
    WTUP_TERMINAL_BACKEND
                         Tool terminal backend. Values: auto, herdr, wezterm,
                         windows-terminal, none.
                         In Herdr workspaces, auto means herdr. On the Zellij
                         path, auto means WezTerm inside WezTerm and otherwise
                         Windows Terminal when available.
    WTUP_TOOL_COMMANDS   Comma-separated commands to open in the tools context.
                         Default: WTUP_WT_COMMANDS or omp,codex.

  Windows Terminal
    WTUP_WT_PROFILE      Windows Terminal profile name (or GUID).
                         Default: aurora_wsl
    WTUP_WT_COMMANDS     Backward-compatible alias for WTUP_TOOL_COMMANDS.
                         Default: omp,codex
    WTUP_WIN_USER        Windows username (used to locate settings.json).
                         Default: autodetected via cmd.exe %USERNAME%

  Portless (consumed by pane scripts)
    PORTLESS_PORT        Override proxy port (default: 1355)
    PORTLESS_HTTPS       Set to 1/true to prefer https URLs in summaries

EXAMPLES
  # Attach/create worktree based on local branch name
  wtup time_scrubber_integration

  # Create a new worktree based on the latest main branch
  wtup -m feature/new-flow

  # Create a new worktree from the current worktree HEAD
  wtup feature/follow-up

  # Create a new worktree for a namespaced branch
  wtup feat/my-feature

  # Create a new worktree from an explicit ref/branch/tag/SHA
  WTUP_BASE_REF=feat/my-feature wtup feat/my-feature-follow-up

  # Create a new worktree and copy current uncommitted changes into it
  wtup -c feature/port-my-wip

  # From inside an existing worktree
  wtup .

  # Force session rebuild (use after changing layouts/scripts)
  wtup --reset .

  # Frontend-only React workspace (single app pane + utility shells)
  WTUP_PROJECT_CONFIG=frontend wtup feat/ui-refresh

  # aurora-ui DS-only workspace
  wtup --component-only feat/components-refresh

  # aurora-ui DS source validated inside a consumer app
  wtup --product-context --ds feat/components-refresh --consumer ../consumer-app

  # DSE alias for consumer-context
  wtup --product-context --ds feat/components-refresh --dse ../design_system_evolution

  # Make a specific repo family auto-detect as frontend
  WTUP_FRONTEND_PROJECT_PATTERNS='*forged-realms*,*another-app*' wtup .

  # Use claude instead of omp in the tools context
  WTUP_TOOL_COMMANDS=claude,codex wtup .

  # Open omp, claude, and codex in the tools context
  WTUP_TOOL_COMMANDS=omp,claude,codex wtup .

RELATED
  wtup-summary   Prints the routes + recent git history (Utility Bash pane uses this).
EOF
}

arg=""
positional_args=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --reset|-r)
      reset_session=1
      shift
      ;;
    --latest-main|--from-latest-main|-m)
      from_latest_main=1
      shift
      ;;
    --carry|--carry-changes|--copy-changes|-c)
      carry_changes=1
      shift
      ;;
    --workflow)
      if [[ $# -lt 2 ]]; then
        echo "wtup: --workflow requires a value" >&2
        exit 2
      fi
      workflow="$2"
      shift 2
      ;;
    --workflow=*)
      workflow="${1#*=}"
      shift
      ;;
    --component-only)
      workflow="component-only"
      shift
      ;;
    --product-context|--consumer-context)
      workflow="consumer-context"
      shift
      ;;
    --ds)
      if [[ $# -lt 2 ]]; then
        echo "wtup: --ds requires a value" >&2
        exit 2
      fi
      ds_target="$2"
      shift 2
      ;;
    --ds=*)
      ds_target="${1#*=}"
      shift
      ;;
    --consumer)
      if [[ $# -lt 2 ]]; then
        echo "wtup: --consumer requires a value" >&2
        exit 2
      fi
      consumer_target="$2"
      shift 2
      ;;
    --consumer=*)
      consumer_target="${1#*=}"
      shift
      ;;
    --dse)
      if [[ $# -lt 2 ]]; then
        echo "wtup: --dse requires a value" >&2
        exit 2
      fi
      consumer_target="$2"
      consumer_kind="dse"
      shift 2
      ;;
    --dse=*)
      consumer_target="${1#*=}"
      consumer_kind="dse"
      shift
      ;;
    --ds-channel)
      if [[ $# -lt 2 ]]; then
        echo "wtup: --ds-channel requires a value" >&2
        exit 2
      fi
      ds_channel="$2"
      shift 2
      ;;
    --ds-channel=*)
      ds_channel="${1#*=}"
      shift
      ;;
    --ds-link)
      if [[ $# -lt 2 ]]; then
        echo "wtup: --ds-link requires a value" >&2
        exit 2
      fi
      ds_link="$2"
      shift 2
      ;;
    --ds-link=*)
      ds_link="${1#*=}"
      shift
      ;;
    --consumer-kind)
      if [[ $# -lt 2 ]]; then
        echo "wtup: --consumer-kind requires a value" >&2
        exit 2
      fi
      consumer_kind="$2"
      shift 2
      ;;
    --consumer-kind=*)
      consumer_kind="${1#*=}"
      shift
      ;;
    --no-prompt)
      no_prompt=1
      shift
      ;;
    --strict-workflow)
      strict_workflow=1
      shift
      ;;
    --workspace-backend)
      if [[ $# -lt 2 ]]; then
        echo "wtup: --workspace-backend requires a value" >&2
        exit 2
      fi
      workspace_backend_request="$2"
      shift 2
      ;;
    --workspace-backend=*)
      workspace_backend_request="${1#*=}"
      shift
      ;;
    --help|-h)
      print_help
      exit 0
      ;;
    -help)
      print_help
      exit 0
      ;;
    --)
      shift
      while [[ $# -gt 0 ]]; do
        positional_args+=("$1")
        shift
      done
      break
      ;;
    *)
      positional_args+=("$1")
      shift
      ;;
  esac
done

case "$workflow" in
  auto|component-only|consumer-context)
    ;;
  product-context)
    workflow="consumer-context"
    ;;
  *)
    echo "wtup: unknown workflow: $workflow (expected: auto, component-only, consumer-context)" >&2
    exit 2
    ;;
esac

case "$ds_channel" in
  "")
    if [[ "$workflow" == "consumer-context" ]]; then
      ds_channel="alpha"
    fi
    ;;
  stable|alpha)
    ;;
  *)
    echo "wtup: unknown --ds-channel: $ds_channel (expected: stable or alpha)" >&2
    exit 2
    ;;
esac

case "$ds_link" in
  source|snapshot)
    ;;
  *)
    echo "wtup: unknown --ds-link: $ds_link (expected: source or snapshot)" >&2
    exit 2
    ;;
esac

case "$consumer_kind" in
  auto|dse|frontend|fullstack)
    ;;
  *)
    echo "wtup: unknown --consumer-kind: $consumer_kind (expected: auto, dse, frontend, fullstack)" >&2
    exit 2
    ;;
esac

case "$workspace_backend_request" in
  auto|herdr|zellij)
    ;;
  *)
    echo "wtup: unknown workspace backend: $workspace_backend_request (expected: auto, herdr, zellij)" >&2
    exit 2
    ;;
esac

if [[ "$workflow" == "auto" ]]; then
  if (( ${#positional_args[@]} > 1 )); then
    echo "wtup: auto workflow accepts one target" >&2
    exit 2
  fi
  if (( ${#positional_args[@]} == 1 )); then
    arg="${positional_args[0]}"
  fi
elif [[ "$workflow" == "component-only" ]]; then
  if [[ -z "$ds_target" ]] && (( ${#positional_args[@]} > 0 )); then
    ds_target="${positional_args[0]}"
  fi
  if (( ${#positional_args[@]} > 1 )); then
    echo "wtup: component-only accepts one aurora-ui target" >&2
    exit 2
  fi
  arg="$ds_target"
elif [[ "$workflow" == "consumer-context" ]]; then
  if [[ -z "$ds_target" ]] && (( ${#positional_args[@]} > 0 )); then
    ds_target="${positional_args[0]}"
  fi
  if [[ -z "$consumer_target" ]] && (( ${#positional_args[@]} > 1 )); then
    consumer_target="${positional_args[1]}"
  fi
  if (( ${#positional_args[@]} > 2 )); then
    echo "wtup: consumer-context accepts at most two positional targets: <ds-target> <consumer-target>" >&2
    exit 2
  fi
fi

if [[ "$workflow" == "auto" ]] && [[ -z "$arg" ]]; then
  echo "usage: wtup [--reset|-r] [--latest-main|-m] [--carry|-c] <worktree-branch-name|path-to-worktree>" >&2
  exit 2
fi

slugify() {
  local input="$1"
  printf '%s' "$input" |
    tr '[:upper:]' '[:lower:]' |
    sed -E 's/[^a-z0-9.]+/-/g; s/^-+//; s/-+$//; s/\.+/./g; s/^\.+//; s/\.+$//'
}

flatten_worktree_name() {
  local input="$1"
  printf '%s' "$input" |
    sed -E 's#/+#-#g'
}

abs_path() {
  local base="$1"
  local p="$2"
  if [[ "$p" == /* ]]; then
    realpath -m "$p"
  else
    realpath -m "$base/$p"
  fi
}

resolve_common_repo_root() {
  local worktree_root="$1"
  local common_dir=""
  local common_abs=""

  common_dir="$(git -C "$worktree_root" rev-parse --git-common-dir 2>/dev/null || true)"
  if [[ -z "$common_dir" ]]; then
    return
  fi

  common_abs="$(abs_path "$worktree_root" "$common_dir")"
  if [[ "$common_abs" == */.git ]]; then
    printf '%s' "${common_abs%/.git}"
  fi
}

resolve_herdr_source_root() {
  local checkout_root="$1"
  local common_root=""

  common_root="$(resolve_common_repo_root "$checkout_root")"
  if [[ -n "$common_root" ]]; then
    printf '%s' "$common_root"
  else
    printf '%s' "$checkout_root"
  fi
}

trim_whitespace() {
  local value="$1"
  value="${value#"${value%%[![:space:]]*}"}"
  value="${value%"${value##*[![:space:]]}"}"
  printf '%s' "$value"
}

pattern_list_matches() {
  local value="$1"
  local patterns_csv="$2"
  local pattern=""
  local patterns=()

  if [[ -z "$patterns_csv" ]]; then
    return 1
  fi

  IFS=',' read -r -a patterns <<< "$patterns_csv"
  for pattern in "${patterns[@]}"; do
    pattern="$(trim_whitespace "$pattern")"
    if [[ -n "$pattern" ]] && [[ "$value" == $pattern ]]; then
      return 0
    fi
  done

  return 1
}

detect_project_config() {
  local worktree_root="$1"
  local worktree_name="$2"
  local explicit_config="${WTUP_PROJECT_CONFIG:-}"
  local frontend_patterns="${WTUP_FRONTEND_PROJECT_PATTERNS:-*forged-realms*}"
  local fullstack_patterns="${WTUP_FULLSTACK_PROJECT_PATTERNS:-}"
  local common_repo_root=""
  local candidate=""
  local candidates=()

  if [[ -n "$explicit_config" ]]; then
    printf '%s' "$explicit_config"
    return
  fi

  common_repo_root="$(resolve_common_repo_root "$worktree_root")"

  candidates+=("$worktree_root")
  candidates+=("$worktree_name")
  if [[ -n "$common_repo_root" ]]; then
    candidates+=("$common_repo_root")
    candidates+=("$(basename "$common_repo_root")")
  fi

  for candidate in "${candidates[@]}"; do
    if pattern_list_matches "$candidate" "$fullstack_patterns"; then
      printf 'fullstack'
      return
    fi
  done

  for candidate in "${candidates[@]}"; do
    if pattern_list_matches "$candidate" "$frontend_patterns"; then
      printf 'frontend'
      return
    fi
  done

  printf 'fullstack'
}

prompt_for_required_target() {
  local label="$1"
  local value=""

  if [[ "$no_prompt" == "1" ]]; then
    echo "wtup: missing required $label target" >&2
    return 1
  fi
  if [[ ! -t 0 ]]; then
    echo "wtup: missing required $label target and stdin is not interactive" >&2
    return 1
  fi

  read -r -p "wtup $label target: " value
  value="$(trim_whitespace "$value")"
  if [[ -z "$value" ]]; then
    echo "wtup: missing required $label target" >&2
    return 1
  fi

  printf '%s' "$value"
}

is_aurora_ui_repo() {
  local root="$1"
  [[ -d "$root/packages/components-v2" && -d "$root/storybook-v2" ]]
}

repo_supports_ds_link_mode() {
  local root="$1"
  local link_mode="$2"
  local pattern=""

  case "$link_mode" in
    source)
      pattern='AURORA_UI_WORKTREE|AURORA_DS_LINK_MODE|AURORA_DS_COMPONENTS_SOURCE'
      ;;
    snapshot)
      pattern='AURORA_DS_LINK_MODE|AURORA_DS_COMPONENTS_PACKAGE|AURORA_DS_SNAPSHOT'
      ;;
    *)
      return 1
      ;;
  esac

  if command -v rg >/dev/null 2>&1; then
    rg -q "$pattern" "$root" \
      -g '!node_modules' -g '!dist' -g '!build' -g '!.git' 2>/dev/null
  else
    return 1
  fi
}

snapshot_artifacts_are_paired() {
  local package_metadata="$1"
  local storybook_metadata="$2"
  local expected_channel="$3"

  [[ -f "$package_metadata" && -f "$storybook_metadata" ]] || return 1
  command -v python3 >/dev/null 2>&1 || return 1

  python3 - "$package_metadata" "$storybook_metadata" "$expected_channel" <<'PY'
import json
import sys

package_path, storybook_path, expected_channel = sys.argv[1:4]

try:
    with open(package_path, encoding="utf-8") as f:
        package = json.load(f)
    with open(storybook_path, encoding="utf-8") as f:
        storybook = json.load(f)
except Exception:
    sys.exit(1)

package_id = package.get("designSystemSnapshotId")
storybook_id = storybook.get("designSystemSnapshotId")
package_channel = package.get("designSystemChannel")
storybook_channel = storybook.get("designSystemChannel")

if (
    package_id
    and storybook_id
    and package_id == storybook_id
    and package_channel == expected_channel
    and storybook_channel == expected_channel
):
    sys.exit(0)

sys.exit(1)
PY
}

detect_consumer_kind() {
  local consumer_root="$1"
  local consumer_name="$2"
  local explicit_kind="$3"
  local detected_config=""

  if [[ "$explicit_kind" != "auto" ]]; then
    printf '%s' "$explicit_kind"
    return
  fi

  case "$consumer_root:$consumer_name:$(basename "$consumer_root")" in
    *design_system_evolution*|*dse*)
      printf 'dse'
      return
      ;;
  esac

  detected_config="$(detect_project_config "$consumer_root" "$consumer_name")"
  printf '%s' "$detected_config"
}

consumer_backend_detected() {
  local consumer_root="$1"
  local kind="$2"

  if [[ "$kind" == "dse" || "$kind" == "fullstack" ]]; then
    if [[ -d "$consumer_root/services/flexplorer-api/backend" ]] || [[ -f "$consumer_root/requirements.txt" ]]; then
      return 0
    fi
  fi

  return 1
}

repo_hint_for_consumer() {
  local kind="$1"
  local hint="${WTUP_CONSUMER_REPO_ROOT:-}"
  local candidate=""

  if [[ -n "$hint" ]]; then
    printf '%s' "$hint"
    return
  fi

  if [[ "$kind" == "dse" ]]; then
    for candidate in \
      "${WTUP_DSE_REPO_ROOT:-}" \
      "$HOME/aurora_design/design_system/design_system_evolution" \
      "$HOME/aurora_design/prototyping/design_system_evolution" \
      "$HOME/aurora_design/worktrees/design_system_evolution"; do
      if [[ -n "$candidate" ]] && git -C "$candidate" rev-parse --show-toplevel >/dev/null 2>&1; then
        git -C "$candidate" rev-parse --show-toplevel
        return
      fi
    done
  fi
}

repo_hint_for_ds() {
  local hint="${WTUP_DS_REPO_ROOT:-${WTUP_AURORA_UI_REPO_ROOT:-}}"
  local cur_root=""

  if [[ -n "$hint" ]]; then
    printf '%s' "$hint"
    return
  fi

  if cur_root="$(git rev-parse --show-toplevel 2>/dev/null)" && is_aurora_ui_repo "$cur_root"; then
    printf '%s' "$cur_root"
  fi
}

resolve_worktree_target() {
  local target="$1"
  local repo_hint="${2:-}"
  local creation_backend="${3:-git}"
  local resolved_root=""
  local resolved_name=""
  local resolved_dir_name=""
  local git_root=""
  local cur_path=""
  local cur_branch=""
  local wt_branch=""
  local wt_parent=""
  local base_ref=""
  local main_remote=""
  local main_branch=""
  local main_remote_ref=""
  local remote_head=""
  local fetch_failed=0
  local counts=""
  local left_count=""
  local right_count=""
  local base_sha=""
  local main_sha=""
  local herdr_json=""
  local herdr_fields=""
  local herdr_source_root=""

  if [[ -z "$target" ]]; then
    echo "wtup: internal error: resolve_worktree_target called without a target" >&2
    return 2
  fi

  if [[ -d "$target" ]]; then
    resolved_root="$(cd "$target" && pwd -P)"
    if ! git -C "$resolved_root" rev-parse --show-toplevel >/dev/null 2>&1; then
      echo "wtup: not a git worktree: $resolved_root" >&2
      return 1
    fi
    resolved_root="$(git -C "$resolved_root" rev-parse --show-toplevel)"
    wt_branch="$(git -C "$resolved_root" rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
    if [[ -n "$wt_branch" ]] && [[ "$wt_branch" != "HEAD" ]]; then
      resolved_name="$wt_branch"
    else
      resolved_name="$(basename "$resolved_root")"
    fi
  else
    resolved_name="$target"
    resolved_dir_name="$(flatten_worktree_name "$resolved_name")"
    if [[ -z "$resolved_dir_name" ]]; then
      echo "wtup: could not derive a worktree directory name from: $resolved_name" >&2
      return 1
    fi

    if [[ -n "$repo_hint" ]]; then
      if ! git_root="$(git -C "$repo_hint" rev-parse --show-toplevel 2>/dev/null)"; then
        echo "wtup: repo hint is not a git checkout: $repo_hint" >&2
        return 1
      fi
    elif ! git_root="$(git rev-parse --show-toplevel 2>/dev/null)"; then
      echo "wtup: run from inside any checkout/worktree of the target repo (or pass a worktree path)" >&2
      return 1
    fi

    while IFS= read -r line; do
      case "$line" in
        worktree\ *)
          cur_path="${line#worktree }"
          cur_branch=""
          ;;
        branch\ refs/heads/*)
          cur_branch="${line#branch refs/heads/}"
          ;;
        "")
          if [[ "$cur_branch" == "$resolved_name" ]]; then
            resolved_root="$cur_path"
            break
          fi
          ;;
      esac
    done < <(git -C "$git_root" worktree list --porcelain; echo)

    if [[ -z "$resolved_root" ]]; then
      wt_parent="${WTUP_WORKTREES_DIR:-"$(dirname "$git_root")/worktrees"}"
      resolved_root="${wt_parent}/${resolved_dir_name}"
      base_ref="${WTUP_BASE_REF:-HEAD}"

      main_remote="${WTUP_MAIN_REMOTE:-origin}"
      main_branch="${WTUP_MAIN_BRANCH:-main}"

      if git -C "$git_root" remote get-url "$main_remote" >/dev/null 2>&1; then
        remote_head="$(git -C "$git_root" symbolic-ref --quiet "refs/remotes/${main_remote}/HEAD" 2>/dev/null || true)"
        if [[ -n "$remote_head" ]]; then
          main_remote_ref="${remote_head#refs/remotes/}"
          main_remote="${main_remote_ref%%/*}"
          main_branch="${main_remote_ref#*/}"
        else
          if ! git -C "$git_root" rev-parse --verify --quiet "refs/remotes/${main_remote}/${main_branch}" >/dev/null 2>&1; then
            if git -C "$git_root" rev-parse --verify --quiet "refs/remotes/${main_remote}/master" >/dev/null 2>&1; then
              main_branch="master"
            fi
          fi
          main_remote_ref="${main_remote}/${main_branch}"
        fi
      else
        main_remote_ref="${main_remote}/${main_branch}"
      fi

      fetch_failed=0
      if git -C "$git_root" remote get-url "$main_remote" >/dev/null 2>&1; then
        if ! GIT_TERMINAL_PROMPT=0 git -C "$git_root" fetch --quiet "$main_remote" "$main_branch" >/dev/null 2>&1; then
          fetch_failed=1
        fi
      fi

      if [[ "$from_latest_main" == "1" ]]; then
        if [[ "$fetch_failed" == "1" ]]; then
          echo "wtup: warning: failed to fetch ${main_remote}/${main_branch}; using local ${main_remote_ref} state" >&2
        fi
        if git -C "$git_root" rev-parse --verify --quiet "${main_remote_ref}^{commit}" >/dev/null 2>&1; then
          base_ref="$main_remote_ref"
        elif git -C "$git_root" show-ref --verify --quiet "refs/heads/${main_branch}"; then
          echo "wtup: warning: ${main_remote_ref} not found; using local ${main_branch}" >&2
          base_ref="$main_branch"
        else
          echo "wtup: error: cannot resolve ${main_remote_ref} (and no local ${main_branch}); cannot create from latest main" >&2
          return 1
        fi
      else
        if git -C "$git_root" rev-parse --verify --quiet "${main_remote_ref}^{commit}" >/dev/null 2>&1 && git -C "$git_root" rev-parse --verify --quiet "${base_ref}^{commit}" >/dev/null 2>&1; then
          counts="$(git -C "$git_root" rev-list --left-right --count "${base_ref}...${main_remote_ref}" 2>/dev/null || true)"
          read -r left_count right_count <<<"$counts" || true
          if [[ -n "${right_count:-}" ]] && [[ "$right_count" != "0" ]]; then
            base_sha="$(git -C "$git_root" rev-parse --short "${base_ref}^{commit}" 2>/dev/null || true)"
            main_sha="$(git -C "$git_root" rev-parse --short "${main_remote_ref}^{commit}" 2>/dev/null || true)"
            echo "wtup: warning: creating '$resolved_name' from ${base_ref} (${base_sha}), but ${main_remote_ref} is ahead by ${right_count} commit(s) (${main_sha})" >&2
            echo "wtup: hint: use 'wtup --latest-main $resolved_name' to base on latest main" >&2
          fi
        fi
      fi

      mkdir -p "$wt_parent"
      if [[ -e "$resolved_root" ]]; then
        echo "wtup: error: target worktree path already exists: $resolved_root" >&2
        echo "wtup: hint: an existing branch may already map to the same flattened path" >&2
        return 1
      fi

      if [[ "$creation_backend" == "herdr" ]]; then
        herdr_source_root="$(resolve_herdr_source_root "$git_root")"
        if ! herdr_json="$(herdr worktree create \
          --cwd "$herdr_source_root" \
          --branch "$resolved_name" \
          --base "$base_ref" \
          --path "$resolved_root" \
          --label "$resolved_name" \
          --no-focus \
          --json)"; then
          echo "wtup: Herdr failed to create worktree '$resolved_name'" >&2
          return 1
        fi
        herdr_fields="$(parse_herdr_worktree_result "$herdr_json")" || return 1
        printf '%s\t%s\t%s\n' "$resolved_root" "$resolved_name" "$herdr_fields"
        return
      elif git -C "$git_root" show-ref --verify --quiet "refs/heads/${resolved_name}"; then
        git -C "$git_root" worktree add "$resolved_root" "$resolved_name" >&2
      else
        git -C "$git_root" worktree add -b "$resolved_name" "$resolved_root" "$base_ref" >&2
      fi
    fi
  fi

  if [[ "$creation_backend" == "herdr" ]]; then
    herdr_source_root="$(resolve_herdr_source_root "$resolved_root")"
    if ! herdr_json="$(herdr worktree open \
      --cwd "$herdr_source_root" \
      --path "$resolved_root" \
      --label "$resolved_name" \
      --no-focus \
      --json)"; then
      echo "wtup: Herdr failed to open worktree '$resolved_root'" >&2
      return 1
    fi
    herdr_fields="$(parse_herdr_worktree_result "$herdr_json")" || return 1
    printf '%s\t%s\t%s\n' "$resolved_root" "$resolved_name" "$herdr_fields"
    return
  fi

  printf '%s\t%s\n' "$resolved_root" "$resolved_name"
}

parse_herdr_worktree_result() {
  local json="$1"

  command -v python3 >/dev/null 2>&1 || {
    echo "wtup: Herdr mode requires python3 for structured API responses" >&2
    return 1
  }

  python3 - "$json" <<'PY'
import json
import sys

try:
    payload = json.loads(sys.argv[1])
    result = payload["result"]
    workspace_id = result["workspace"]["workspace_id"]
    tab_id = result["tab"]["tab_id"]
    pane_id = result["root_pane"]["pane_id"]
    already_open = 1 if result.get("already_open", False) else 0
except (KeyError, TypeError, ValueError, json.JSONDecodeError) as exc:
    print(f"wtup: invalid Herdr worktree response: {exc}", file=sys.stderr)
    sys.exit(1)

print(f"{workspace_id}\t{tab_id}\t{pane_id}\t{already_open}")
PY
}

get_herdr_layout_token() {
  local workspace_id="$1"
  local workspace_json=""

  if ! workspace_json="$(herdr workspace get "$workspace_id")"; then
    echo "wtup: failed to inspect Herdr workspace layout state: $workspace_id" >&2
    return 1
  fi

  python3 - "$workspace_json" <<'PY'
import json
import sys

try:
    workspace = json.loads(sys.argv[1])["result"]["workspace"]
except (KeyError, TypeError, json.JSONDecodeError) as exc:
    print(f"wtup: invalid Herdr workspace response: {exc}", file=sys.stderr)
    sys.exit(1)

print((workspace.get("tokens") or {}).get("wtup_layout", ""))
PY
}

escape_bash_double_quoted() {
  local value="$1"
  value="${value//\\/\\\\}"
  value="${value//\"/\\\"}"
  printf '%s' "$value"
}

resolve_internal_helper() {
  local name="$1"
  local script_path=""
  local script_dir=""
  local candidate=""

  script_path="$(readlink -f "${BASH_SOURCE[0]}")"
  script_dir="$(cd "$(dirname "$script_path")" && pwd -P)"
  for candidate in \
    "$script_dir/libexec/$name" \
    "$script_dir/../libexec/wtup/$name"; do
    if [[ -x "$candidate" ]]; then
      printf '%s' "$candidate"
      return
    fi
  done

  echo "wtup: internal helper is not installed: $name" >&2
  return 1
}

append_windows_terminal_command() {
  local mode="$1"
  local agent_cmd="$2"
  local agent_title
  local escaped_cmd

  agent_title="$(trim_whitespace "${agent_cmd%% *}")"
  if [[ -z "$agent_title" ]]; then
    agent_title="tool"
  fi

  escaped_cmd="$(escape_bash_double_quoted "$agent_cmd")"

  case "$mode" in
    new-tab)
      cmd+=(new-tab -p "$wt_profile_arg" --title "${wt_name} ${agent_title}" wsl.exe)
      ;;
    split-pane)
      cmd+=(split-pane -V -p "$wt_profile_arg" --title "${wt_name} ${agent_title}" wsl.exe)
      ;;
    *)
      echo "wtup: unsupported Windows Terminal mode: $mode" >&2
      return 1
      ;;
  esac

  if [[ -n "$distro" ]]; then
    cmd+=(-d "$distro")
  fi

  cmd+=(--cd "$wt_root" -- bash -ic "exec ${escaped_cmd}")
}

windows_terminal_available() {
  command -v cmd.exe >/dev/null 2>&1 &&
    command -v wt.exe >/dev/null 2>&1 &&
    command -v wsl.exe >/dev/null 2>&1
}

wezterm_tab_backend_available() {
  [[ -n "${WEZTERM_PANE:-}" ]] && command -v wezterm >/dev/null 2>&1
}

spawn_wezterm_agent_command() {
  local mode="$1"
  local target_pane="$2"
  local agent_cmd="$3"
  local escaped_cmd

  escaped_cmd="$(escape_bash_double_quoted "$agent_cmd")"

  case "$mode" in
    new-tab)
      wezterm cli spawn --pane-id "$WEZTERM_PANE" --cwd "$wt_root" -- bash -ic "exec ${escaped_cmd}"
      ;;
    split-pane)
      wezterm cli split-pane --pane-id "$target_pane" --right --cwd "$wt_root" -- bash -ic "exec ${escaped_cmd}"
      ;;
    *)
      echo "wtup: unsupported WezTerm mode: $mode" >&2
      return 1
      ;;
  esac
}

launch_wezterm_tools_tab() {
  local first_pane
  local split_pane
  local i

  if (( ${#wt_agent_commands[@]} == 0 )); then
    return 0
  fi

  if ! first_pane="$(spawn_wezterm_agent_command new-tab "" "${wt_agent_commands[0]}" 2>/dev/null)"; then
    return 1
  fi
  first_pane="${first_pane//$'\r'/}"
  first_pane="$(trim_whitespace "$first_pane")"
  if [[ -z "$first_pane" ]]; then
    return 1
  fi

  wezterm cli set-tab-title --pane-id "$first_pane" "${wt_name} tools" >/dev/null 2>&1 || true

  for i in "${!wt_agent_commands[@]}"; do
    if (( i == 0 )); then
      continue
    fi
    if ! split_pane="$(spawn_wezterm_agent_command split-pane "$first_pane" "${wt_agent_commands[i]}" 2>/dev/null)"; then
      echo "wtup: warning: failed to open WezTerm tools pane for: ${wt_agent_commands[i]}" >&2
      continue
    fi
    split_pane="${split_pane//$'\r'/}"
  done

  if [[ -n "${WEZTERM_PANE:-}" ]]; then
    wezterm cli activate-pane --pane-id "$WEZTERM_PANE" >/dev/null 2>&1 || true
  fi
}

resolve_terminal_backend() {
  local requested="$1"

  case "$requested" in
    ""|auto)
      if wezterm_tab_backend_available; then
        printf 'wezterm'
      elif windows_terminal_available; then
        printf 'windows-terminal'
      else
        printf 'none'
      fi
      ;;
    wezterm)
      printf 'wezterm'
      ;;
    herdr)
      printf 'herdr'
      ;;
    windows-terminal|windows_terminal|windows|wt)
      printf 'windows-terminal'
      ;;
    none|off|0|false)
      printf 'none'
      ;;
    *)
      echo "wtup: unknown WTUP_TERMINAL_BACKEND: $requested (expected: auto, herdr, wezterm, windows-terminal, none)" >&2
      return 2
      ;;
  esac
}

herdr_context_available() {
  local status_json=""
  local protocol=""

  [[ "${HERDR_ENV:-}" == "1" ]] || return 1
  [[ -n "${HERDR_WORKSPACE_ID:-}" && -n "${HERDR_TAB_ID:-}" && -n "${HERDR_PANE_ID:-}" ]] || return 1
  [[ -n "${HERDR_SOCKET_PATH:-}" ]] || return 1
  command -v herdr >/dev/null 2>&1 || return 1
  command -v python3 >/dev/null 2>&1 || return 1

  status_json="$(herdr status client --json 2>/dev/null)" || return 1
  protocol="$(python3 - "$status_json" <<'PY'
import json
import sys

try:
    print(int(json.loads(sys.argv[1]).get("protocol", 0)))
except (TypeError, ValueError, json.JSONDecodeError):
    print(0)
PY
)"
  [[ "$protocol" =~ ^[0-9]+$ ]] && (( protocol >= 17 )) || return 1
  herdr workspace get "$HERDR_WORKSPACE_ID" >/dev/null 2>&1
}

resolve_workspace_backend() {
  local requested="$1"

  case "$requested" in
    auto)
      if herdr_context_available; then
        printf 'herdr'
      elif [[ "${HERDR_ENV:-}" == "1" ]]; then
        echo "wtup: detected a Herdr pane, but its API is unavailable or older than protocol 17" >&2
        echo "wtup: repair the Herdr session or explicitly use WTUP_WORKSPACE_BACKEND=zellij" >&2
        return 1
      else
        printf 'zellij'
      fi
      ;;
    herdr)
      if ! herdr_context_available; then
        echo "wtup: Herdr backend requires a Herdr-managed pane and protocol 17 or newer" >&2
        return 1
      fi
      printf 'herdr'
      ;;
    zellij)
      printf 'zellij'
      ;;
  esac
}

wt_profile="${WTUP_WT_PROFILE:-aurora_wsl}"
wt_terminal_backend="${WTUP_TERMINAL_BACKEND:-auto}"
wt_project_config=""
wt_layout=""

wt_agent_commands=()
IFS=',' read -r -a wt_agent_tokens <<< "${WTUP_TOOL_COMMANDS:-${WTUP_WT_COMMANDS:-omp,codex}}"
for token in "${wt_agent_tokens[@]}"; do
  token="$(trim_whitespace "$token")"
  if [[ -n "$token" ]]; then
    wt_agent_commands+=("$token")
  fi
done

wt_root=""
wt_name=""
wt_dir_name=""
ds_root=""
ds_name=""
consumer_root=""
consumer_name=""
consumer_detected_kind=""
consumer_has_backend=0
ds_host=""
consumer_host=""
resolved_line=""

workspace_backend="$(resolve_workspace_backend "$workspace_backend_request")"
primary_creation_backend="git"
if [[ "$workspace_backend" == "herdr" ]]; then
  primary_creation_backend="herdr"
  if [[ -n "${WTUP_ZELLIJ_LAYOUT:-}" ]]; then
    echo "wtup: WTUP_ZELLIJ_LAYOUT is not supported by the Herdr backend" >&2
    echo "wtup: use WTUP_WORKSPACE_BACKEND=zellij for custom Zellij KDL layouts" >&2
    exit 2
  fi
  case "$wt_terminal_backend" in
    ""|auto|herdr|none|off|0|false)
      ;;
    *)
      echo "wtup: terminal backend '$wt_terminal_backend' conflicts with native Herdr composition" >&2
      echo "wtup: use WTUP_TERMINAL_BACKEND=herdr, none, or WTUP_WORKSPACE_BACKEND=zellij" >&2
      exit 2
      ;;
  esac
fi

if [[ "$workflow" == "component-only" ]]; then
  if [[ -z "$ds_target" ]]; then
    if ! ds_target="$(prompt_for_required_target "aurora-ui")"; then
      exit 1
    fi
  fi
  ds_repo_hint="$(repo_hint_for_ds || true)"
  IFS=$'\t' read -r ds_root ds_name herdr_workspace_id herdr_tab_id herdr_root_pane_id herdr_already_open < <(
    resolve_worktree_target "$ds_target" "$ds_repo_hint" "$primary_creation_backend"
  )
  if [[ -z "$ds_root" || -z "$ds_name" ]]; then
    exit 1
  fi
  if ! is_aurora_ui_repo "$ds_root"; then
    if [[ "$strict_workflow" == "1" || "$no_prompt" == "1" ]]; then
      echo "wtup: component-only requires an aurora-ui worktree with packages/components-v2 and storybook-v2: $ds_root" >&2
      exit 1
    fi
    echo "wtup: warning: component-only support not found at $ds_root; falling back to auto workflow" >&2
    workflow="auto"
    arg="$ds_root"
  else
    wt_root="$ds_root"
    wt_name="$ds_name"
  fi
fi

if [[ "$workflow" == "consumer-context" ]]; then
  if [[ -z "$ds_target" ]]; then
    if ! ds_target="$(prompt_for_required_target "aurora-ui")"; then
      exit 1
    fi
  fi
  if [[ -z "$consumer_target" ]]; then
    if ! consumer_target="$(prompt_for_required_target "consumer")"; then
      exit 1
    fi
  fi

  ds_repo_hint="$(repo_hint_for_ds || true)"
  IFS=$'\t' read -r ds_root ds_name herdr_workspace_id herdr_tab_id herdr_root_pane_id herdr_already_open < <(
    resolve_worktree_target "$ds_target" "$ds_repo_hint" "$primary_creation_backend"
  )
  if [[ -z "$ds_root" || -z "$ds_name" ]]; then
    exit 1
  fi
  if ! is_aurora_ui_repo "$ds_root"; then
    if [[ "$strict_workflow" == "1" || "$no_prompt" == "1" ]]; then
      echo "wtup: consumer-context requires --ds to resolve to aurora-ui with packages/components-v2 and storybook-v2: $ds_root" >&2
      exit 1
    fi
    echo "wtup: warning: DS workflow support not found at $ds_root; falling back to auto workflow for $ds_root" >&2
    workflow="auto"
    arg="$ds_root"
  else
    consumer_repo_hint="$(repo_hint_for_consumer "$consumer_kind" || true)"
    if [[ -z "$consumer_repo_hint" && ! -d "$consumer_target" ]]; then
      cur_repo_hint="$(git rev-parse --show-toplevel 2>/dev/null || true)"
      if [[ -n "$cur_repo_hint" ]] && [[ "$(realpath -m "$cur_repo_hint")" != "$(realpath -m "$ds_root")" ]]; then
        consumer_repo_hint="$cur_repo_hint"
      fi
    fi
    if [[ -z "$consumer_repo_hint" && ! -d "$consumer_target" ]]; then
      echo "wtup: error: --consumer must be an existing worktree path, or set WTUP_CONSUMER_REPO_ROOT for branch targets" >&2
      exit 1
    fi
    IFS=$'\t' read -r consumer_root consumer_name < <(resolve_worktree_target "$consumer_target" "$consumer_repo_hint" "git")
    if [[ -z "$consumer_root" || -z "$consumer_name" ]]; then
      exit 1
    fi

    consumer_detected_kind="$(detect_consumer_kind "$consumer_root" "$consumer_name" "$consumer_kind")"
    if ! repo_supports_ds_link_mode "$consumer_root" "$ds_link"; then
      if [[ "$strict_workflow" == "1" || "$no_prompt" == "1" ]]; then
        echo "wtup: consumer repo does not advertise DS $ds_link linking support: $consumer_root" >&2
        exit 1
      fi
      echo "wtup: warning: consumer repo does not advertise DS $ds_link linking support; launching with environment wiring only" >&2
    fi

    if [[ "$ds_link" == "snapshot" ]]; then
      snapshot_package="${ds_root}/packages/components-v2/dist/${ds_channel}-package"
      snapshot_metadata="${ds_root}/storybook-v2/storybook-static/design-system-snapshot.json"
      snapshot_package_metadata="${snapshot_package}/design-system-snapshot.json"
      if [[ ! -e "$snapshot_package" || ! -f "$snapshot_metadata" ]]; then
        if [[ "$strict_workflow" == "1" || "$no_prompt" == "1" ]]; then
          echo "wtup: snapshot mode requires package and Storybook metadata artifacts for channel '$ds_channel'" >&2
          echo "wtup: expected package:  $snapshot_package" >&2
          echo "wtup: expected metadata: $snapshot_metadata" >&2
          exit 1
        fi
        echo "wtup: warning: snapshot artifacts for channel '$ds_channel' are missing; launch will still expose the expected artifact paths" >&2
      elif ! snapshot_artifacts_are_paired "$snapshot_package_metadata" "$snapshot_metadata" "$ds_channel"; then
        if [[ "$strict_workflow" == "1" || "$no_prompt" == "1" ]]; then
          echo "wtup: snapshot mode requires package and Storybook metadata to share one '$ds_channel' snapshot ID" >&2
          echo "wtup: package metadata:  $snapshot_package_metadata" >&2
          echo "wtup: storybook metadata: $snapshot_metadata" >&2
          exit 1
        fi
        echo "wtup: warning: snapshot package and Storybook metadata do not share one '$ds_channel' snapshot ID; rerun yarn design-system:snapshot:$ds_channel for a paired snapshot" >&2
      fi
    fi

    if consumer_backend_detected "$consumer_root" "$consumer_detected_kind"; then
      consumer_has_backend=1
    fi

    ds_host="$(slugify "$ds_name")"
    consumer_host="$(slugify "$consumer_name")"
    wt_root="$ds_root"
    wt_name="${ds_name}+${consumer_name}"
  fi
fi

if [[ "$workflow" == "auto" ]]; then
  IFS=$'\t' read -r wt_root wt_name herdr_workspace_id herdr_tab_id herdr_root_pane_id herdr_already_open < <(
    resolve_worktree_target "$arg" "" "$primary_creation_backend"
  )
  if [[ -z "$wt_root" || -z "$wt_name" ]]; then
    exit 1
  fi
fi

inherited_worktree_host="${WORKTREE_HOST:-}"
if [[ "${WTUP_MANAGED_ENV:-}" == "1" ]]; then
  inherited_worktree_host=""
fi
wt_host="${WTUP_WORKTREE_HOST:-${inherited_worktree_host:-"$(slugify "$wt_name")"}}"
if [[ -z "$wt_host" ]]; then
  echo "wtup: could not derive a portless-safe name from: $wt_name" >&2
  exit 1
fi

if [[ "$workflow" == "auto" ]]; then
  wt_project_config="$(detect_project_config "$wt_root" "$wt_name")"
  case "$wt_project_config" in
    fullstack|frontend)
      ;;
    *)
      echo "wtup: unknown WTUP_PROJECT_CONFIG: $wt_project_config (expected: fullstack or frontend)" >&2
      exit 2
      ;;
  esac
elif [[ "$workflow" == "component-only" ]]; then
  wt_project_config="component-only"
else
  wt_project_config="consumer-context"
fi
wt_layout="${WTUP_ZELLIJ_LAYOUT:-}"

if [[ "$carry_changes" == "1" ]]; then
  if ! src_root="$(git rev-parse --show-toplevel 2>/dev/null)"; then
    echo "wtup: error: --carry must be run from inside the source worktree" >&2
    exit 1
  fi

  src_root_abs="$(realpath -m "$src_root")"
  wt_root_abs="$(realpath -m "$wt_root")"
  if [[ "$src_root_abs" != "$wt_root_abs" ]]; then
    src_common="$(git -C "$src_root" rev-parse --git-common-dir 2>/dev/null || true)"
    tgt_common="$(git -C "$wt_root" rev-parse --git-common-dir 2>/dev/null || true)"
    if [[ -z "$src_common" ]] || [[ -z "$tgt_common" ]]; then
      echo "wtup: error: --carry requires both source and target to be git worktrees" >&2
      exit 1
    fi
    if [[ "$(abs_path "$src_root" "$src_common")" != "$(abs_path "$wt_root" "$tgt_common")" ]]; then
      echo "wtup: error: --carry only supports worktrees of the same repo" >&2
      exit 1
    fi

    src_status="$(git -C "$src_root" status --porcelain=v1 2>/dev/null || true)"
    if [[ -n "$src_status" ]]; then
      if [[ -n "$(git -C "$src_root" diff --name-only --diff-filter=U 2>/dev/null || true)" ]]; then
        echo "wtup: error: cannot carry changes with unresolved merge conflicts in source" >&2
        exit 1
      fi

      tgt_status="$(git -C "$wt_root" status --porcelain=v1 2>/dev/null || true)"
      if [[ -n "$tgt_status" ]]; then
        echo "wtup: error: target worktree has uncommitted changes; clean it before using --carry" >&2
        exit 1
      fi

      echo "wtup: carrying uncommitted changes -> $wt_root" >&2

      stash_msg="wtup carry: ${src_root_abs} -> ${wt_root_abs}"
      git -C "$src_root" stash push -u -m "$stash_msg" >/dev/null
      stash_sha="$(git -C "$src_root" rev-parse stash@{0} 2>/dev/null || true)"

      carry_failed=0
      if ! git -C "$wt_root" stash apply --index stash@{0}; then
        echo "wtup: warning: applying carried changes to target had conflicts; stash kept (stash@{0})" >&2
        carry_failed=1
      fi

      if ! git -C "$src_root" stash apply --index stash@{0}; then
        echo "wtup: error: failed to restore source changes; recover with: git stash list && git stash apply --index stash@{0}" >&2
        exit 1
      fi

      if [[ "$carry_failed" == "0" ]] && [[ -n "$stash_sha" ]]; then
        cur_sha="$(git -C "$src_root" rev-parse stash@{0} 2>/dev/null || true)"
        if [[ "$cur_sha" == "$stash_sha" ]]; then
          git -C "$src_root" stash drop stash@{0} >/dev/null 2>&1 || true
        else
          echo "wtup: warning: stash@{0} changed; not dropping carry stash" >&2
        fi
      fi
    fi
  fi
fi

if [[ "$workspace_backend" == "herdr" ]]; then
  case "$wt_terminal_backend" in
    none|off|0|false)
      tools_backend="none"
      ;;
    *)
      tools_backend="herdr"
      ;;
  esac
else
  tools_backend="$(resolve_terminal_backend "$wt_terminal_backend")"
fi

# Open configured tool commands in a sibling terminal context.
if [[ "$tools_backend" == "wezterm" ]] && (( ${#wt_agent_commands[@]} > 0 )); then
  if wezterm_tab_backend_available; then
    if ! launch_wezterm_tools_tab; then
      echo "wtup: warning: failed to open WezTerm tools tab" >&2
    fi
  else
    echo "wtup: warning: WezTerm backend requested but wtup is not running inside WezTerm" >&2
  fi
elif [[ "$tools_backend" == "windows-terminal" ]] && (( ${#wt_agent_commands[@]} > 0 )) && windows_terminal_available; then
  distro="${WSL_DISTRO_NAME:-}"

  # Resolve the profile to a GUID to avoid duplicates (eg. hidden WSL auto-profiles)
  wt_profile_arg="$wt_profile"
  win_user="${WTUP_WIN_USER:-}"
  if [[ -z "$win_user" ]]; then
    win_user="$(cmd.exe /c echo %USERNAME% 2>/dev/null | tr -d '\r' || true)"
  fi
  if [[ -z "$win_user" ]]; then
    win_user="LouisBlackburn"
  fi
  wt_settings="/mnt/c/Users/${win_user}/AppData/Local/Packages/Microsoft.WindowsTerminal_8wekyb3d8bbwe/LocalState/settings.json"
  if [[ -f "$wt_settings" ]] && command -v python3 >/dev/null 2>&1; then
    guid="$(python3 - "$wt_settings" "$wt_profile" <<'PY'
import json
import sys

path, name = sys.argv[1], sys.argv[2]
try:
    with open(path, encoding="utf-8") as f:
        data = json.load(f)
except Exception:
    sys.exit(0)

profiles = (data.get("profiles") or {}).get("list") or []
matches = [p for p in profiles if p.get("name") == name and p.get("guid")]

# Prefer visible profiles
for p in matches:
    if not p.get("hidden", False):
        print(p["guid"])
        sys.exit(0)

if matches:
    print(matches[0]["guid"])
PY
    )"
    guid="${guid//$'\r'/}"
    if [[ -n "$guid" ]]; then
      wt_profile_arg="$guid"
    fi
  fi

  cmd=(cmd.exe /c start "" wt.exe -w new)
  if (( ${#wt_agent_commands[@]} == 1 )); then
    append_windows_terminal_command new-tab "${wt_agent_commands[0]}"
  elif (( ${#wt_agent_commands[@]} == 2 )); then
    append_windows_terminal_command new-tab "${wt_agent_commands[0]}"
    cmd+=(";")
    append_windows_terminal_command split-pane "${wt_agent_commands[1]}"
  else
    for i in "${!wt_agent_commands[@]}"; do
      if (( i > 0 )); then
        cmd+=(";")
      fi
      append_windows_terminal_command new-tab "${wt_agent_commands[i]}"
    done
  fi

  "${cmd[@]}" >/dev/null 2>&1 || true
fi

cd "$wt_root"
export WORKTREE_NAME="$wt_name"
export WORKTREE_HOST="$wt_host"
export WTUP_PROJECT_CONFIG="$wt_project_config"
export WTUP_WORKFLOW="$workflow"
export WTUP_ROOT="$wt_root"
export WTUP_MANAGED_ENV=1
export AGENT_BROWSER_SESSION="wtup-${wt_host}"
unset AGENT_BROWSER_AUTO_CONNECT

if [[ "$workflow" == "component-only" || "$workflow" == "consumer-context" ]]; then
  if [[ -z "$ds_channel" ]]; then
    ds_channel="alpha"
  fi
  if [[ -z "$ds_host" ]]; then
    ds_host="$(slugify "$ds_name")"
  fi

  export AURORA_UI_WORKTREE="$ds_root"
  export AURORA_DS_WORKTREE="$ds_root"
  export AURORA_DS_WORKTREE_HOST="$ds_host"
  export AURORA_DS_CHANNEL="$ds_channel"
  export AURORA_DS_LINK_MODE="$ds_link"
  export AURORA_DS_COMPONENTS_SOURCE="${ds_root}/packages/components-v2/src"
  export AURORA_DS_COMPONENTS_PACKAGE="${ds_root}/packages/components-v2/dist/${ds_channel}-package"
  export AURORA_DS_STORYBOOK_STATIC="${ds_root}/storybook-v2/storybook-static"
  export AURORA_DS_SNAPSHOT="${ds_root}/storybook-v2/storybook-static/design-system-snapshot.json"
fi

if [[ "$workflow" == "consumer-context" ]]; then
  export AURORA_CONSUMER_WORKTREE="$consumer_root"
  export AURORA_CONSUMER_WORKTREE_HOST="$consumer_host"
  export AURORA_CONSUMER_KIND="$consumer_detected_kind"
fi

if [[ "$workspace_backend" == "herdr" ]]; then
  if [[ -z "$herdr_workspace_id" || -z "$herdr_tab_id" || -z "$herdr_root_pane_id" ]]; then
    echo "wtup: Herdr did not return the workspace, tab, and pane identifiers required for layout creation" >&2
    exit 1
  fi

  if [[ "$reset_session" == "1" && "$herdr_already_open" == "1" ]]; then
    if [[ "$herdr_workspace_id" == "${HERDR_WORKSPACE_ID:-}" ]]; then
      echo "wtup: cannot reset the Herdr workspace that is running this command" >&2
      echo "wtup: run the reset from another Herdr workspace" >&2
      exit 1
    fi

    herdr workspace close "$herdr_workspace_id" >/dev/null
    herdr_reset_source_root="$(resolve_herdr_source_root "$wt_root")"
    herdr_reset_json="$(herdr worktree open \
      --cwd "$herdr_reset_source_root" \
      --path "$wt_root" \
      --label "$wt_name" \
      --no-focus \
      --json)"
    herdr_reset_fields="$(parse_herdr_worktree_result "$herdr_reset_json")"
    IFS=$'\t' read -r herdr_workspace_id herdr_tab_id herdr_root_pane_id herdr_already_open <<<"$herdr_reset_fields"
  fi

  if [[ "$herdr_already_open" == "1" ]]; then
    herdr_layout_token="$(get_herdr_layout_token "$herdr_workspace_id")"
    expected_herdr_layout="${workflow}:${wt_project_config}:2"
    if [[ "$herdr_layout_token" == "$expected_herdr_layout" ]]; then
      herdr workspace focus "$herdr_workspace_id" >/dev/null
      exit 0
    elif [[ -n "$herdr_layout_token" ]]; then
      echo "wtup: Herdr workspace has layout '$herdr_layout_token'; expected '$expected_herdr_layout'" >&2
      echo "wtup: run wtup --reset from another Herdr workspace to rebuild it" >&2
      exit 1
    fi
    herdr_append_layout=1
  fi

  export WTUP_HERDR_WORKSPACE_ID="$herdr_workspace_id"
  export WTUP_HERDR_TAB_ID="$herdr_tab_id"
  export WTUP_HERDR_ROOT_PANE_ID="$herdr_root_pane_id"
  export WTUP_HERDR_APPEND_LAYOUT="$herdr_append_layout"
  export WTUP_CONSUMER_HAS_BACKEND="$consumer_has_backend"
  export WTUP_TERMINAL_BACKEND="$tools_backend"

  herdr workspace rename "$herdr_workspace_id" "$wt_name" >/dev/null

  wtup_herdr_bin="$(resolve_internal_helper wtup-herdr)"
  "$wtup_herdr_bin"
  exit 0
fi

# Generate supported layouts from the same canonical model used by Herdr.
layout_arg="$wt_layout"
layout_src="${HOME}/.config/zellij/layouts/${wt_layout}.kdl"
layout_out="${HOME}/.cache/wtup/layouts/${wt_host}.kdl"
if [[ -z "${WTUP_ZELLIJ_LAYOUT:-}" ]]; then
  wtup_layout_bin="$(resolve_internal_helper wtup-layout)"
  canonical_layout_args=(
    kdl
    --workflow "$workflow"
    --project-config "$wt_project_config"
    --root "$wt_root"
    --consumer-root "${consumer_root:-$wt_root}"
  )
  if [[ "$consumer_has_backend" == "1" ]]; then
    canonical_layout_args+=(--consumer-backend)
  fi
  mkdir -p "$(dirname "$layout_out")"
  "$wtup_layout_bin" "${canonical_layout_args[@]}" >"$layout_out"
  layout_arg="$layout_out"
elif [[ -f "$layout_src" ]] && command -v python3 >/dev/null 2>&1; then
  mkdir -p "$(dirname "$layout_out")"
  python3 - "$layout_src" "$layout_out" "$wt_name" <<'PY'
import sys

src, dst, wt_name = sys.argv[1], sys.argv[2], sys.argv[3]

def kdl_escape(s: str) -> str:
    return s.replace('\\', '\\\\').replace('"', '\\"')

with open(src, encoding='utf-8') as f:
    data = f.read()

escaped = kdl_escape(wt_name)

replacements = [
    ('tab name="[WT]"', f'tab name="[WT] - {escaped}"'),
    ('tab name="[WT] - {WorktreeName}"', f'tab name="[WT] - {escaped}"'),
]

for needle, repl in replacements:
    if needle in data:
        data = data.replace(needle, repl, 1)
        break

with open(dst, 'w', encoding='utf-8', newline='\n') as f:
    f.write(data)
PY
  layout_arg="$layout_out"
fi

if [[ "$tools_backend" == "wezterm" ]] && [[ -n "${WEZTERM_PANE:-}" ]]; then
  wezterm cli set-tab-title --pane-id "$WEZTERM_PANE" "${wt_name} zellij" >/dev/null 2>&1 || true
fi

if [[ "$reset_session" == "1" ]]; then
  zellij delete-session -f "$wt_host" >/dev/null 2>&1 || true
fi

session_line="$(zellij list-sessions -n 2>/dev/null | awk -v s="$wt_host" '$1 == s { print; exit }')"
if [[ -n "$session_line" ]] && [[ "$session_line" == *"(EXITED"* ]]; then
  # Avoid resurrecting stale sessions: they preserve old pane commands and tab names.
  zellij delete-session "$wt_host" >/dev/null 2>&1 || true
  session_line=""
fi

if [[ -n "$session_line" ]]; then
  exec zellij attach "$wt_host"
else
  exec zellij -s "$wt_host" -n "$layout_arg"
fi
